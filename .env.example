# Provider-уудыг энэ дарааллаар туршина. API key/model алдаа гарвал дараагийнх руу шилжинэ.
AI_PROVIDERS=gemini,groq,openrouter

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Manhwa AI Translator

# Local Ollama хэрэглэх үед AI_PROVIDERS-д ollama-г нэмнэ.
OLLAMA_BASE_URL=http://localhost:11434/v1/
OLLAMA_MODEL=qwen3-vl:8b

# OpenAI төлбөртэй provider-ийг дараа идэвхжүүлэх бол AI_PROVIDERS-д openai-г нэмнэ.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
